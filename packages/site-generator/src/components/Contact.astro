---
import type { BusinessData } from "@demo-site-generator/shared";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;
const social = business.socialProfiles ?? [];
const socialLabel: Record<string, string> = {
  instagram: "IG",
  facebook: "FB",
  linkedin: "IN",
  tiktok: "TK",
  whatsapp: "WA",
  website: "WEB",
};
---

<section id="contact" class="section">
  <div class="container-site grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="reveal">
      <p class="eyebrow mb-3">Contact</p>
      <h2 class="section-title mb-6" data-i18n="get-in-touch">Get in Touch</h2>
      <p class="text-body-lg leading-relaxed text-text-secondary mb-9">
        Have a question or ready to get started? We'd love to hear from you — reach out on any channel below.
      </p>

      <div class="space-y-4">
        {business.phone && (
          <a href={`tel:${business.phone}`} class="card group flex items-center gap-4 transition-colors" style="padding:1.25rem 1.5rem">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-white" style="background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)))">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <div>
              <p class="text-caption font-semibold uppercase tracking-widest text-text-muted">Call us</p>
              <p class="mt-0.5 font-semibold text-text-primary group-hover:text-accent-dark transition-colors">{business.phone}</p>
            </div>
          </a>
        )}
        {business.email && (
          <a href={`mailto:${business.email}`} class="card group flex items-center gap-4 transition-colors" style="padding:1.25rem 1.5rem">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-white" style="background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)))">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <div>
              <p class="text-caption font-semibold uppercase tracking-widest text-text-muted">Email us</p>
              <p class="mt-0.5 font-semibold text-text-primary group-hover:text-accent-dark transition-colors">{business.email}</p>
            </div>
          </a>
        )}
        {business.location && (
          <div class="card flex items-center gap-4" style="padding:1.25rem 1.5rem">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-white" style="background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)))">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <div>
              <p class="text-caption font-semibold uppercase tracking-widest text-text-muted">Visit us</p>
              <p class="mt-0.5 font-semibold text-text-primary">{business.location.address}, {business.location.city}</p>
            </div>
          </div>
        )}
      </div>

      {social.length > 0 && (
        <div class="mt-8 flex gap-3">
          {social.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-border text-text-secondary transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent-dark hover:shadow-card"
            >
              <span class="text-caption font-bold uppercase tracking-wider">{socialLabel[s.platform] ?? s.platform.slice(0, 2)}</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="reveal reveal-delay-1">
      <form class="card space-y-5" style="border-radius:1.5rem; padding:2.25rem" action="#" method="get">
        <p class="font-primary text-heading-md font-semibold text-text-primary" data-i18n="send-message">Send us a message</p>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="label">Name</label>
            <input type="text" required class="field" placeholder="Your name" />
          </div>
          <div>
            <label class="label">Email</label>
            <input type="email" required class="field" placeholder="you@email.com" />
          </div>
        </div>
        <div>
          <label class="label">Subject</label>
          <input type="text" class="field" placeholder="How can we help?" />
        </div>
        <div>
          <label class="label">Message</label>
          <textarea rows="5" class="field" placeholder="Tell us more."></textarea>
        </div>
        <button type="submit" class="btn-primary btn-lg w-full">Send Message</button>
      </form>
    </div>

    {business.location && (business.location.address || business.location.city) && (
      <div class="reveal mt-12 lg:col-span-2">
        <div class="overflow-hidden rounded-[1.5rem] shadow-card ring-1 ring-border" style="height:22rem">
          <iframe
            title="Map — {business.name}"
            src={`https://www.google.com/maps?q=${encodeURIComponent([business.location.address, business.location.city, business.location.state].filter(Boolean).join(", "))}&output=embed`}
            width="100%"
            height="100%"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    )}
  </div>
</section>
