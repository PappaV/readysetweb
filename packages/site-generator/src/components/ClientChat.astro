---
import type { BusinessData } from "@demo-site-generator/shared";

interface Props {
  business: BusinessData;
  chatEndpoint?: string;
}

const { business, chatEndpoint = "" } = Astro.props;
const endpoint = chatEndpoint.replace(/\/$/, "");
const data = JSON.stringify({
  endpoint,
  businessId: business.id ?? "",
  businessName: business.name,
});
---

{endpoint && (
  <div id="client-chat" class="fixed bottom-24 left-6 z-50" data-config={data}>
    <button
      id="chat-toggle"
      class="flex h-14 w-14 items-center justify-center rounded-full text-white shadow-card-lg transition-transform hover:scale-105"
      style="background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)))"
      aria-label="Chat with us"
    >
      <svg id="chat-open-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
      </svg>
      <svg id="chat-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div id="chat-panel" class="glass-dark hidden fixed bottom-36 left-6 flex max-h-[26rem] w-[22rem] max-w-[calc(100vw-3rem)] flex-col overflow-hidden rounded-2xl shadow-card-lg">
      <div class="flex items-center gap-3 px-5 py-4" style="background:linear-gradient(135deg, hsl(var(--color-primary)), hsl(var(--color-accent)))">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-white/20 text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
        </div>
        <div>
          <p class="font-primary text-sm font-semibold text-white">Questions about this site?</p>
          <p class="text-xs text-white/70">We usually reply within minutes</p>
        </div>
      </div>

      <div id="chat-messages" class="flex-1 space-y-3 overflow-y-auto px-4 py-4 text-sm" style="max-height:16rem">
        <div class="max-w-[85%] rounded-2xl rounded-tl-sm px-4 py-2.5 text-white/80" style="background:hsl(var(--color-ink-soft)); border:1px solid hsl(0 0% 100%/0.08)">
          Hi! 👋 Want to change something on this page, ask about a service, or make this site yours? Just type below.
        </div>
      </div>

      <div id="chat-contact" class="grid grid-cols-2 gap-2 border-t px-4 pt-3" style="border-color:hsl(0 0% 100%/0.08)">
        <input id="chat-name" type="text" placeholder="Your name" class="rounded-lg border px-3 py-2 text-sm outline-none placeholder:text-white/30" style="background:hsl(var(--color-ink-soft)); border-color:hsl(0 0% 100%/0.12); color:#fff" />
        <input id="chat-email" type="email" placeholder="Email (optional)" class="rounded-lg border px-3 py-2 text-sm outline-none placeholder:text-white/30" style="background:hsl(var(--color-ink-soft)); border-color:hsl(0 0% 100%/0.12); color:#fff" />
      </div>

      <form id="chat-form" class="flex items-center gap-2 border-t px-4 py-3" style="border-color:hsl(0 0% 100%/0.08)">
        <input
          id="chat-input"
          type="text"
          placeholder="Type a message…"
          class="flex-1 rounded-lg border px-3 py-2 text-sm outline-none placeholder:text-white/30 focus:border-accent"
          style="background:hsl(var(--color-ink-soft)); border-color:hsl(0 0% 100%/0.12); color:#fff"
        />
        <button type="submit" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white" style="background:hsl(var(--color-accent))" aria-label="Send message">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
        </button>
      </form>
    </div>
  </div>
)}

<script>
  const root = document.getElementById("client-chat");
  if (root) {
    const cfg = JSON.parse(root.dataset.config ?? "{}");
    const toggle = document.getElementById("chat-toggle")!;
    const panel = document.getElementById("chat-panel")!;
    const openIcon = document.getElementById("chat-open-icon")!;
    const closeIcon = document.getElementById("chat-close-icon")!;
    const messagesEl = document.getElementById("chat-messages")!;
    const form = document.getElementById("chat-form") as HTMLFormElement;
    const input = document.getElementById("chat-input") as HTMLInputElement;
    const nameEl = document.getElementById("chat-name") as HTMLInputElement;
    const emailEl = document.getElementById("chat-email") as HTMLInputElement;

    let open = false;
    let lastFetched = 0;
    let pollTimer: number | undefined;

    const esc = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    function addMessage(direction: "client" | "admin", text: string) {
      const div = document.createElement("div");
      div.className =
        direction === "client"
          ? "ml-auto max-w-[85%] rounded-2xl rounded-tr-sm px-4 py-2.5 text-white"
          : "max-w-[85%] rounded-2xl rounded-tl-sm px-4 py-2.5 text-white/80";
      div.style.background =
        direction === "client"
          ? "hsl(var(--color-accent))"
          : "hsl(var(--color-ink-soft))";
      div.style.border = direction === "admin" ? "1px solid hsl(0 0% 100% / 0.08)" : "none";
      div.innerHTML = esc(text).replace(/\n/g, "<br/>");
      messagesEl.appendChild(div);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    async function loadMessages() {
      if (!cfg.endpoint || !cfg.businessId) return;
      try {
        const res = await fetch(`${cfg.endpoint}/api/conversations/by-business/${encodeURIComponent(cfg.businessId)}`);
        const data = await res.json();
        if (!data?.messages?.length) return;
        const visible = data.messages.filter((m: { createdAt: string }) => new Date(m.createdAt).getTime() > lastFetched);
        for (const m of visible) addMessage(m.direction, m.text);
        lastFetched = Date.now();
      } catch {
        // ignore transient errors
      }
    }

    function startPolling() {
      if (pollTimer) return;
      loadMessages();
      pollTimer = window.setInterval(loadMessages, 6000);
    }

    toggle.addEventListener("click", () => {
      open = !open;
      panel.classList.toggle("hidden", !open);
      openIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      if (open) startPolling();
      else {
        if (pollTimer) window.clearInterval(pollTimer);
        pollTimer = undefined;
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      addMessage("client", text);
      input.value = "";
      try {
        await fetch(`${cfg.endpoint}/api/conversations/ingest`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            businessId: cfg.businessId,
            businessName: cfg.businessName,
            clientName: nameEl.value.trim() || undefined,
            clientEmail: emailEl.value.trim() || undefined,
            text,
          }),
        });
        addMessage("admin", "Thanks — we've got your message and will reply right here shortly.");
      } catch {
        addMessage("admin", "Sorry, we couldn't send that right now. Please try again.");
      }
    });
  }
</script>
