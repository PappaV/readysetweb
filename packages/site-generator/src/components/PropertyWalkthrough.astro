---
import type { BusinessData } from "@demo-site-generator/shared";
import { photosForCategory } from "@demo-site-generator/hero-engine";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;
const walkthrough = business.walkthrough;
const rooms = walkthrough?.rooms ?? [];
const stock = photosForCategory(business.category);

// Seed a deterministic stock-photo pool so every business's tour differs even
// without real photos (mirrors how the gallery picks its fallback imagery).
function hashName(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}
const seed = hashName(business.name || "home");
const stockPool = stock.length
  ? Array.from({ length: Math.max(rooms.length, 1) }, (_, i) => stock[(seed + i * 3) % stock.length])
  : [];

const roomsWithImage = rooms.map((room, i) => ({
  ...room,
  photoUrl: room.photoUrl ?? stockPool[i] ?? undefined,
}));
const total = roomsWithImage.length;
---

{
  total > 0 && (
    <section id="walkthrough" class="section section-dark relative overflow-hidden">
      <div class="pointer-events-none absolute -left-24 top-1/3 h-72 w-72 rounded-full opacity-25 blur-[100px]" style="background:radial-gradient(circle, hsl(var(--color-accent)/0.5), transparent 65%)"></div>
      <div class="container-site relative">
        <div class="flex flex-wrap items-end justify-between gap-6 reveal">
          <div>
            <p class="eyebrow mb-4" style="color:hsl(var(--color-accent))">Virtual Walkthrough</p>
            <h2 class="section-title text-white">{walkthrough?.heading ?? "Take the walkthrough"}</h2>
            <p class="section-subtitle" style="color:hsl(var(--color-text-secondary))">
              {walkthrough?.intro ?? `A guided, room-by-room tour of ${business.name}.`}
            </p>
          </div>
          <div class="flex items-center gap-3 text-sm text-white/50">
            <span id="wt-counter">Room 1 of {total}</span>
          </div>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_1.1fr]">
          <!-- Floor plan -->
          <div class="reveal rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-7" style="backdrop-filter:blur(12px)">
            <div class="mb-4 flex items-center justify-between">
              <p class="text-xs font-semibold uppercase tracking-widest text-white/40">Floor plan</p>
              <button id="wt-prev" type="button" class="hidden h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Previous room">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              </button>
            </div>
            <svg id="wt-plan" viewBox="0 0 100 100" class="mx-auto w-full max-w-md" role="img" aria-label="Property floor plan">
              <rect x="0" y="0" width="100" height="100" fill="hsl(var(--color-surface) / 0.06)" rx="2" />
              {
                roomsWithImage.map((room, i) => (
                  <g
                    data-wt-room={i}
                    class="wt-room"
                    role="button"
                    tabindex="0"
                    aria-label={room.name}
                    style={{
                      cursor: "pointer",
                      outline: "none",
                    }}
                  >
                    <rect
                      x={room.x}
                      y={room.y}
                      width={room.width}
                      height={room.height}
                      rx="2"
                      fill={i === 0 ? "hsl(var(--color-accent) / 0.35)" : "hsl(var(--color-accent) / 0.12)"}
                      stroke={i === 0 ? "hsl(var(--color-accent))" : "hsl(var(--color-accent) / 0.4)"}
                      stroke-width="0.6"
                    />
                    <text x={room.x + 2} y={room.y + 5} font-size="2.4" fill="hsl(var(--color-text-primary) / 0.9)" font-family="var(--font-secondary)">
                      {room.name.slice(0, 22)}
                    </text>
                    <text x={room.x + 2} y={room.y + 9} font-size="1.8" fill="hsl(var(--color-text-secondary))" font-family="var(--font-secondary)">
                      {i + 1}
                    </text>
                  </g>
                ))
              }
            </svg>
          </div>

          <!-- Active room -->
          <div class="relative reveal reveal-delay-1">
            <div class="group relative aspect-[4/3] w-full overflow-hidden rounded-3xl">
              {roomsWithImage.map((room, i) => (
                <div data-wt-panel={i} class={i === 0 ? "absolute inset-0 opacity-100 transition-opacity duration-500" : "absolute inset-0 opacity-0 transition-opacity duration-500"} style="pointer-events:none">
                  {room.photoUrl && (
                    <img src={room.photoUrl} alt={room.name} class="h-full w-full object-cover" loading={i === 0 ? "eager" : "lazy"} />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 flex flex-wrap items-end justify-between gap-4 p-6">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-widest" style="color:hsl(var(--color-accent))">Stop {i + 1}</p>
                      <h3 class="mt-1 font-primary text-2xl font-semibold text-white sm:text-3xl">{room.name}</h3>
                    </div>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </span>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6" style="backdrop-filter:blur(12px)">
              {
                roomsWithImage.map((room, i) => (
                  <p data-wt-text={i} class={i === 0 ? "text-body leading-relaxed text-white/80" : "hidden text-body leading-relaxed text-white/80"}>
                    {room.description || `${room.name} — part of the tour of this property.`}
                  </p>
                ))
              }
              <div class="mt-5 flex items-center justify-between gap-4">
                <div class="flex gap-2">
                  {
                    roomsWithImage.map((room, i) => (
                      <button
                        type="button"
                        data-wt-dot={i}
                        class={i === 0 ? "h-2 rounded-full bg-white transition-all duration-300" : "h-2 w-2 rounded-full bg-white/25 transition-all duration-300"}
                        style={i === 0 ? "width:1.5rem" : undefined}
                        aria-label={`Go to ${room.name}`}
                      />
                    ))
                  }
                </div>
                <button id="wt-next" type="button" class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:scale-[1.03] active:scale-95" style="background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)))">
                  Next room
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6l6 6-6 6" /></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const plan = document.getElementById("wt-plan");
  const rooms = plan?.querySelectorAll<SVGGElement>("[data-wt-room]") ?? [];
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-wt-panel]"));
  const texts = Array.from(document.querySelectorAll<HTMLElement>("[data-wt-text]"));
  const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-wt-dot]"));
  const counter = document.getElementById("wt-counter");
  const nextBtn = document.getElementById("wt-next");
  const prevBtn = document.getElementById("wt-prev");

  let current = 0;
  const total = rooms.length;
  if (total <= 1) nextBtn?.classList.add("opacity-40", "pointer-events-none");
  prevBtn?.classList.remove("hidden");
  prevBtn?.classList.add("flex");

  function show(index: number) {
    if (total === 0) return;
    current = (index + total) % total;
    rooms.forEach((room, i) => {
      const rect = room.querySelector("rect")!;
      rect.setAttribute("fill", i === current ? "hsl(var(--color-accent) / 0.35)" : "hsl(var(--color-accent) / 0.12)");
      rect.setAttribute("stroke", i === current ? "hsl(var(--color-accent))" : "hsl(var(--color-accent) / 0.4)");
      room.setAttribute("tabindex", i === current ? "0" : "-1");
    });
    panels.forEach((panel, i) => {
      panel.classList.toggle("opacity-100", i === current);
      panel.classList.toggle("opacity-0", i !== current);
    });
    texts.forEach((text, i) => {
      text.classList.toggle("hidden", i !== current);
    });
    dots.forEach((dot, i) => {
      dot.classList.toggle("bg-white", i === current);
      dot.classList.toggle("bg-white/25", i !== current);
      dot.style.width = i === current ? "1.5rem" : "0.5rem";
    });
    if (counter) counter.textContent = `Room ${current + 1} of ${total}`;
  }

  rooms.forEach((room) => {
    const activate = () => show(Number(room.dataset.wtRoom ?? 0));
    room.addEventListener("click", activate);
    room.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        activate();
      }
    });
  });
  nextBtn?.addEventListener("click", () => show(current + 1));
  prevBtn?.addEventListener("click", () => show(current - 1));
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") show(current + 1);
    if (e.key === "ArrowLeft") show(current - 1);
  });
</script>

<style>
  .wt-room:hover rect {
    stroke: hsl(var(--color-accent)) !important;
    stroke-width: 1 !important;
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }
  .wt-room:focus-visible rect {
    stroke: hsl(var(--color-accent)) !important;
    stroke-width: 1.2 !important;
  }
</style>
