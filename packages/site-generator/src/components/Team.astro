---
import type { BusinessData } from "@demo-site-generator/shared";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;
const team = business.team ?? [];
const initials = (name: string) => name.split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

<section id="team" class="section">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center reveal">
      <p class="eyebrow mb-3 justify-center">Our Team</p>
      <h2 class="section-title mb-4">Meet the Experts</h2>
      <p class="section-subtitle mx-auto">The specialists behind every detail.</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member, i) => (
        <article class="card card-hover-line reveal group text-center" style={{ animationDelay: `${(i % 3) * 80}ms` }}>
          <div class="relative mx-auto mb-5 flex h-28 w-28 items-center justify-center">
            <div class="absolute inset-0 rounded-full opacity-30 blur-xl" style="background:hsl(var(--color-accent))"></div>
            <span class="relative flex h-24 w-24 items-center justify-center rounded-full border-2 border-white font-primary text-3xl font-bold text-white shadow-lg" style="background:linear-gradient(135deg, hsl(var(--color-primary)), hsl(var(--color-accent)))">
              {initials(member.name)}
            </span>
          </div>
          <h3 class="font-primary text-heading-md font-semibold text-text-primary">{member.name}</h3>
          <p class="mt-1.5 text-caption font-semibold uppercase tracking-widest text-accent">{member.role}</p>
          {member.bio && (
            <p class="mt-3 text-body-sm leading-relaxed text-text-secondary">{member.bio}</p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
