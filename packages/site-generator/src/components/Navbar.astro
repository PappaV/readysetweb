---
import type { BusinessData } from "@demo-site-generator/shared";
import Logo from "./Logo.astro";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;

const sections = (business.sections?.length ? business.sections : [])
  .filter((s) => s.enabled !== false)
  .sort((a, b) => a.order - b.order)
  .filter((s) => s.type !== "hero");

const labelMap: Record<string, string> = {
  about: "About",
  services: "Services",
  gallery: "Gallery",
  reviews: "Reviews",
  contact: "Contact",
  faq: "FAQ",
  team: "Team",
  pricing: "Pricing",
  booking: "Book",
  blog: "Journal",
};
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <div class="container-site flex items-center justify-between py-4">
    <div id="nav-bar" class="flex w-full items-center justify-between gap-4 rounded-2xl px-4 py-2.5 transition-all duration-500 sm:px-5" style="background:transparent">
      <Logo business={business} size={40} showName nameClass="text-white" />

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
        {sections.map((s) => {
          const label = labelMap[s.type] ?? s.type;
          return (
            <a href={`#${s.id}`} class="relative rounded-full px-3.5 py-2 text-sm font-medium text-white/75 transition-colors hover:text-white" data-i18n={s.type === "blog" ? "blog" : s.type}>
              {label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <div class="glass-dark hidden items-center rounded-full p-1 md:flex" aria-label="Language">
          {["en", "af", "zu"].map((l) => (
            <button data-i18n-lang={l} onclick={`window.__applyLang && window.__applyLang('${l}')`} class="rounded-full px-2.5 py-1 text-xs font-semibold text-white/70 transition-colors hover:text-white" style="background:transparent">
              {l.toUpperCase()}
            </button>
          ))}
        </div>
        <a href="#booking" class="btn-accent hidden sm:inline-flex" style="padding-top:0.625rem;padding-bottom:0.625rem;font-size:0.875rem;">
          <span data-i18n="book-now">Book Now</span>
        </a>
        <button
          id="nav-toggle"
          class="flex h-10 w-10 items-center justify-center rounded-xl text-white md:hidden"
          aria-label="Toggle menu"
        >
          <svg id="nav-open-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="nav-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="nav-mobile" class="container-site hidden px-6 md:hidden">
    <nav class="glass-dark flex flex-col gap-1 rounded-2xl p-3" aria-label="Mobile navigation">
      {sections.map((s) => {
        const label = labelMap[s.type] ?? s.type;
        return <a href={`#${s.id}`} class="rounded-xl px-4 py-3 text-white/85 transition-colors hover:bg-white/10">{label}</a>;
      })}
      <a href="#booking" class="btn-accent w-full">Book Now</a>
    </nav>
  </div>
</header>

<script>
  const bar = document.getElementById("nav-bar")!;
  const toggle = document.getElementById("nav-toggle")!;
  const mobile = document.getElementById("nav-mobile")!;
  const openIcon = document.getElementById("nav-open-icon")!;
  const closeIcon = document.getElementById("nav-close-icon")!;

  const onScroll = () => {
    if (window.scrollY > 48) {
      bar.style.background = "rgba(10,12,16,0.72)";
      bar.style.backdropFilter = "blur(20px) saturate(160%)";
      bar.style.setProperty("-webkit-backdrop-filter", "blur(20px) saturate(160%)");
      bar.style.boxShadow = "0 8px 32px -12px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.06)";
      bar.style.border = "1px solid rgba(255,255,255,0.06)";
    } else {
      bar.style.background = "transparent";
      bar.style.backdropFilter = "none";
      bar.style.setProperty("-webkit-backdrop-filter", "none");
      bar.style.boxShadow = "none";
      bar.style.border = "none";
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  toggle.addEventListener("click", () => {
    mobile.classList.toggle("hidden");
    openIcon.classList.toggle("hidden");
    closeIcon.classList.toggle("hidden");
  });
  mobile.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile.classList.add("hidden");
      openIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
    })
  );
</script>
