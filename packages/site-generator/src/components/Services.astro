---
import type { BusinessData } from "@demo-site-generator/shared";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;
const services = business.services ?? [];
const icons = ["sparkles", "shield", "clock", "leaf", "star", "heart", "award", "gem"];
const iconPaths: Record<string, string> = {
  sparkles: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  shield: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  clock: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  leaf: "M5 19c0-7 5-12 14-12 0 9-5 14-12 14-1 0-2 0-2-2zm0 0c0-4 3-7 8-9",
  star: "M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.563.563 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z",
  heart: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  award: "M9.813 15.904L9 18.75l-.873-2.846a9.755 9.755 0 001.686 0zM7.5 8.25h9m-9 0a4.5 4.5 0 119 0m-9 0a4.5 4.5 0 119 0m-4.5 6l.75 2.44L12 21.75l2.25-3.06.75-2.44",
  gem: "M6 3h12l4 6-10 13L2 9l4-6zm.086 6h11.828M12 3L8.086 9m7.828 0L12 3M12 22l4-13M12 22L8 9",
};
---

<section id="services" class="section">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6 reveal">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4" data-i18n="our-services">Our Services</p>
        <h2 class="section-title">Signature experiences,<br /> refined to perfection</h2>
      </div>
      <p class="max-w-sm text-sm leading-relaxed text-text-secondary">
        Every treatment is tailored to you — from first consultation to final touch.
      </p>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, i) => (
        <article class="card card-hover-line reveal group" style={{ animationDelay: `${(i % 3) * 80}ms` }}>
          <div class="flex items-start justify-between">
            <span class="flex h-13 w-13 items-center justify-center rounded-2xl text-white shadow-lg" style="width:3.25rem;height:3.25rem;background:linear-gradient(135deg, hsl(var(--color-accent)), hsl(var(--color-primary)));box-shadow:hsl(var(--color-accent)/0.25)">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[icons[i % icons.length]] ?? iconPaths.sparkles} />
              </svg>
            </span>
            <span class="font-primary text-sm font-semibold" style="color:hsl(var(--color-text-muted)/0.45)">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>
          <h3 class="font-primary mt-6 text-xl font-semibold text-text-primary">{service.name}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">{service.description}</p>
          {(service.price || service.duration) && (
            <div class="mt-6 flex items-center justify-between border-t pt-5" style="border-color:hsl(var(--color-border))">
              {service.price && <span class="font-primary text-lg font-bold" style="color:hsl(var(--color-accent-dark))">{service.price}</span>}
              {service.duration && <span class="tag">{service.duration}</span>}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
