{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "db:push": {}
  },
  "globalEnv": ["DATABASE_URL", "OPENAI_API_KEY", "VERCEL_TOKEN", "NETLIFY_AUTH_TOKEN"]
}