---
import type { BusinessData } from "@demo-site-generator/shared";

interface Props {
  business: BusinessData;
}

const { business } = Astro.props;
const reviews = business.reviews ?? [];
const avg = reviews.length
  ? (reviews.reduce((a, r) => a + (r.rating ?? 0), 0) / reviews.length).toFixed(1)
  : "5.0";
const platformColors: Record<string, string> = {
  google: "#4285F4",
  facebook: "#1877F2",
  yelp: "#D32323",
  tripadvisor: "#00AF87",
};
const initials = (name: string) => name.split(/\s+/).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

<section id="reviews" class="section">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center reveal">
      <p class="eyebrow mb-4 justify-center">Testimonials</p>
      <h2 class="section-title" data-i18n="loved">Loved by our clients</h2>
      <div class="mt-7 inline-flex items-center gap-3 rounded-2xl bg-surface-elevated px-6 py-4 shadow-card ring-1 ring-border">
        <div class="flex text-amber-400">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          ))}
        </div>
        <span class="font-primary text-2xl font-bold text-text-primary">{avg}</span>
        <span class="text-sm text-text-muted">/ 5 · {reviews.length} reviews</span>
      </div>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {reviews.slice(0, 9).map((review, i) => (
        <figure class="card reveal group flex flex-col" style={{ animationDelay: `${(i % 3) * 80}ms` }}>
          <svg class="h-7 w-7" style="color:hsl(var(--color-accent)/0.35)" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-text-secondary">
            "{review.text}"
          </blockquote>
          <figcaption class="mt-6 flex items-center justify-between border-t pt-5" style="border-color:hsl(var(--color-border))">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full text-xs font-bold text-white" style="background:linear-gradient(135deg, hsl(var(--color-primary)), hsl(var(--color-accent)))">
                {initials(review.author || "?")}
              </span>
              <div>
                <p class="font-semibold text-text-primary">{review.author}</p>
                <div class="mt-0.5 flex text-amber-400">
                  {Array.from({ length: 5 }).map((_, j) => (
                    <svg class={j < (review.rating ?? 0) ? "h-3.5 w-3.5" : "h-3.5 w-3.5 opacity-25"} fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              </div>
            </div>
            {review.platform && (
              <span class="rounded-full px-3 py-1 text-xs font-semibold text-white" style={{ background: platformColors[review.platform] ?? "#64748b" }}>
                {review.platform}
              </span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
